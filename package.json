{
  "name": "pharmacy-web",
  "version": "1.0.0",
  "private": true,
  "description": "Hostinger-ready Express and MySQL pharmacy application",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build": "node --check server.js && node --check web/service.js && node --check web/public/app.js",
    "test": "node --test --test-timeout=60000 web/test/*.test.js",
    "test:browser": "playwright test --config web/playwright.config.js",
    "format": "prettier --write server.js \"web/**/*.js\" \"web/public/*.css\" web/public/index.html"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "mysql2": "3.24.6",
    "sharp": "0.35.5"
  },
  "license": "GPL-3.0-only",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
